# ==============================================================================
# AI Resume Analysis - Environment Configuration Template
# Copy this file to .env and configure the variables for your environment:
#   cp .env.example .env
# NOTE: Never commit your actual .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-random-50-character-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database Configuration (Defaults to SQLite db.sqlite3 when USE_MYSQL=False)
# ------------------------------------------------------------------------------
USE_MYSQL=False
DB_NAME=ai_resume_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ------------------------------------------------------------------------------
# Machine Learning & BERT Inference Settings
# ------------------------------------------------------------------------------
# Device for SentenceTransformer inference: 'cpu' or 'cuda'
BERT_DEVICE=cpu
# Max sequence length for resume text chunking
BERT_MAX_SEQ_LENGTH=256
